+/* 32 位图标自带 alpha 通道，透明与否以 alpha 为准。 */
+static BOOL icon_has_alpha_channel( HICON handle )
+{
+    ICONINFO info;
+    BITMAP bm;
+    BOOL ret = FALSE;
+
+    if (!GetIconInfo( handle, &info )) return FALSE;
+    if (info.hbmColor && GetObjectW( info.hbmColor, sizeof(bm), &bm ))
+        ret = bm.bmBitsPixel == 32;
+    if (info.hbmColor) DeleteObject( info.hbmColor );
+    if (info.hbmMask) DeleteObject( info.hbmMask );
+    return ret;
+}
