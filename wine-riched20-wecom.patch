+/* Pull the first file path out of the clipboard's CF_HDROP, if any. */
+static BOOL clipboard_first_file_path( WCHAR *path, DWORD len )
+{
+    HGLOBAL hmem;
+    DROPFILES *df;
+    BOOL ret = FALSE;
+
+    *path = 0;
+    if (!OpenClipboard( NULL )) return FALSE;
+    if ((hmem = GetClipboardData( CF_HDROP )))
+    {
+        if ((df = GlobalLock( hmem )))
+        {
+            if (df->fWide)
+                lstrcpynW( path, (const WCHAR *)((const BYTE *)df + df->pFiles), len );
+            else
+            {
+                char narrow[MAX_PATH];
+                lstrcpynA( narrow, (const char *)df + df->pFiles, MAX_PATH );
+                MultiByteToWideChar( CP_ACP, 0, narrow, -1, path, len );
+            }
+            ret = path[0] != 0;
+            GlobalUnlock( hmem );
+        }
+    }
+    CloseClipboard();
+    TRACE("clipboard file [%s] -> %d\n", debugstr_w( path ), ret);
+    return ret;
+}
+
+static BOOL path_has_image_extension( const WCHAR *path )
+{
+    static const WCHAR *extensions[] =
+    {
+        L".png", L".jpg", L".jpeg", L".gif", L".bmp", L".webp", L".ico"
+    };
+    const WCHAR *ext = wcsrchr( path, '.' );
+    UINT i;
+
+    if (!ext) return FALSE;
+    for (i = 0; i < ARRAY_SIZE( extensions ); i++)
+        if (!wcsicmp( ext, extensions[i] )) return TRUE;
+    return FALSE;
+}
+
+static void delete_stale_paste_files( const WCHAR *dir )
+{
+    WCHAR mask[MAX_PATH], name[MAX_PATH];
+    WIN32_FIND_DATAW fd;
+    ULARGE_INTEGER cutoff, stamp;
+    FILETIME now;
+    HANDLE find;
+
+    swprintf( mask, MAX_PATH, L"%swecom-paste-*.bmp", dir );
+    if ((find = FindFirstFileW( mask, &fd )) == INVALID_HANDLE_VALUE) return;
+    GetSystemTimeAsFileTime( &now );
+    cutoff.LowPart = now.dwLowDateTime;
+    cutoff.HighPart = now.dwHighDateTime;
+    cutoff.QuadPart -= (ULONGLONG)3600 * 10000000;
+
+    do
+    {
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) continue;
+        stamp.LowPart = fd.ftLastWriteTime.dwLowDateTime;
+        stamp.HighPart = fd.ftLastWriteTime.dwHighDateTime;
+        if (stamp.QuadPart >= cutoff.QuadPart) continue;
+        swprintf( name, MAX_PATH, L"%s%s", dir, fd.cFileName );
+        DeleteFileW( name );
+    } while (FindNextFileW( find, &fd ));
+    FindClose( find );
+}
