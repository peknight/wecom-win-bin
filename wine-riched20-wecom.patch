+static void ME_PopupDefaultContextMenu(ME_TextEditor *editor, int x, int y, HWND owner)
+{
+    CHARRANGE sel;
+    HMENU menu;
+    HRESULT hr;
+    UINT id;
+
+    ME_GetSelectionOfs( editor, &sel.cpMin, &sel.cpMax );
+    if (!(menu = CreatePopupMenu()))
+    {
+        ERR("could not create context menu\n");
+        return;
+    }
+    AppendMenuW( menu, MF_STRING | (sel.cpMax > sel.cpMin ? 0 : MF_GRAYED), 1, L"Cut" );
+    AppendMenuW( menu, MF_STRING | (sel.cpMax > sel.cpMin ? 0 : MF_GRAYED), 2, L"Copy" );
+    AppendMenuW( menu, MF_STRING, 3, L"Paste" );
+    AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( menu, MF_STRING | (sel.cpMax > sel.cpMin ? 0 : MF_GRAYED), 4, L"Delete" );
+    AppendMenuW( menu, MF_STRING, 5, L"Select All" );
+    id = TrackPopupMenu( menu, TPM_LEFTALIGN | TPM_RIGHTBUTTON | TPM_RETURNCMD | TPM_NONOTIFY,
+                         x, y, 0, owner, NULL );
+    TRACE("default menu %p owner %p at %d,%d -> id %u, last error %lu\n",
+          menu, owner, x, y, id, GetLastError());
+    DestroyMenu( menu );
+
+    switch (id)
+    {
+    case 1: editor_handle_message( editor, WM_CUT, 0, 0, &hr ); break;
+    case 2: editor_handle_message( editor, WM_COPY, 0, 0, &hr ); break;
+    case 3: editor_handle_message( editor, WM_PASTE, 0, 0, &hr ); break;
+    case 4: ME_DeleteSelection( editor ); break;
+    case 5: editor_handle_message( editor, EM_SETSEL, 0, -1, &hr ); break;
+    default: break;
+    }
+}
