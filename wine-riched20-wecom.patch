+/* Ask the host's registered drop target to take the file, exactly as if the
+ * user had dragged it over the caret.  WeCom refuses static OLE pictures from
+ * IRichEditOleCallback::QueryInsertObject but its own file drop path works. */
+static HRESULT paste_file_via_drop( ME_TextEditor *editor, const WCHAR *path )
+{
+    static const WCHAR prop[] = L"OleDropTargetInterface";
+    ME_Cursor *cursor = editor->pCursors;
+    IDropTarget *target = NULL;
+    IDataObject *data = NULL;
+    HWND hwnd = NULL, w, under;
+    POINT pt;
+    POINTL ptl;
+    DWORD effect = DROPEFFECT_COPY;
+    HRESULT hr;
+
+    if (editor->have_texthost2)
+        ITextHost2_TxGetWindow( editor->texthost, &hwnd );
+    if (!hwnd) hwnd = GetActiveWindow();
+    if (!hwnd) hwnd = GetFocus();
+    if (!hwnd)
+    {
+        TRACE("no host window for drop\n");
+        return E_FAIL;
+    }
+
+    /* same coordinate math as EM_POSFROMCHAR */
+    pt.x = cursor->run->pt.x + ME_PointFromChar( editor, cursor->run, cursor->nOffset, TRUE )
+           + editor->rcFormat.left - editor->horz_si.nPos;
+    pt.y = cursor->run->pt.y + cursor->para->pt.y + editor->rcFormat.top - editor->vert_si.nPos;
+    ClientToScreen( hwnd, &pt );
+    TRACE("drop point %ld,%ld host %p rcFormat %ld,%ld\n",
+          pt.x, pt.y, hwnd, editor->rcFormat.left, editor->rcFormat.top);
+
+    under = WindowFromPoint( pt );
+    for (w = under; w && !target; w = GetParent( w ))
+        if ((target = GetPropW( w, prop )))
+            TRACE("drop target %p on %p (under point)\n", target, w);
+    for (w = hwnd; w && !target; w = GetParent( w ))
+        if ((target = GetPropW( w, prop )))
+            TRACE("drop target %p on %p (from host)\n", target, w);
+    if (!target)
+    {
+        TRACE("host has no registered drop target\n");
+        return E_FAIL;
