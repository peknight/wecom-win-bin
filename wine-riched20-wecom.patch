+/* Minimal IDataObject that offers a single CF_HDROP file.  riched20 hands one
+ * of these to the host's IDropTarget when the host refuses static pictures,
+ * so that hosts with a working file drop path (WeCom) can take the image. */
+typedef struct FileDataObjectImpl {
+    IDataObject IDataObject_iface;
+    LONG ref;
+    HGLOBAL hdrop;
+    FORMATETC fmt;
+} FileDataObjectImpl;
+
+static inline FileDataObjectImpl *impl_from_IFileDataObject(IDataObject *iface)
+{
+    return CONTAINING_RECORD(iface, FileDataObjectImpl, IDataObject_iface);
+}
+
+static HRESULT WINAPI FileDataObjectImpl_QueryInterface(IDataObject *iface, REFIID riid, void **out)
+{
+    TRACE("(%p)->(%s)\n", iface, debugstr_guid(riid));
+
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IDataObject))
+    {
+        IDataObject_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI FileDataObjectImpl_AddRef(IDataObject *iface)
+{
+    FileDataObjectImpl *This = impl_from_IFileDataObject(iface);
+    return InterlockedIncrement(&This->ref);
+}
+
+static ULONG WINAPI FileDataObjectImpl_Release(IDataObject *iface)
+{
+    FileDataObjectImpl *This = impl_from_IFileDataObject(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    if (!ref)
+    {
+        GlobalFree(This->hdrop);
+        free(This);
+    }
+    return ref;
+}
+
+static HRESULT WINAPI FileDataObjectImpl_GetData(IDataObject *iface, FORMATETC *fmt, STGMEDIUM *med)
+{
+    FileDataObjectImpl *This = impl_from_IFileDataObject(iface);
+
+    TRACE("(%p)->(fmt=%#x tym=%#lx)\n", This, fmt->cfFormat, fmt->tymed);
+    if (fmt->lindex != -1) return DV_E_LINDEX;
+    if (!(fmt->tymed & TYMED_HGLOBAL)) return DV_E_TYMED;
+    if (fmt->cfFormat != CF_HDROP) return DV_E_FORMATETC;
+
+    med->tymed = TYMED_HGLOBAL;
+    med->hGlobal = This->hdrop;
+    med->pUnkForRelease = (IUnknown *)iface;
+    IDataObject_AddRef(iface);
+    return S_OK;
+}
+
+static HRESULT WINAPI FileDataObjectImpl_GetDataHere(IDataObject *iface, FORMATETC *fmt, STGMEDIUM *med)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI FileDataObjectImpl_QueryGetData(IDataObject *iface, FORMATETC *fmt)
+{
+    TRACE("(%p)->(fmt=%#x tym=%#lx)\n", iface, fmt->cfFormat, fmt->tymed);
+    if (fmt->lindex != -1) return DV_E_LINDEX;
+    if (fmt->cfFormat != CF_HDROP) return DV_E_FORMATETC;
+    if (!(fmt->tymed & TYMED_HGLOBAL)) return DV_E_TYMED;
+    return S_OK;
+}
+
+static HRESULT WINAPI FileDataObjectImpl_GetCanonicalFormatEtc(IDataObject *iface, FORMATETC *in, FORMATETC *out)
+{
+    if (out)
+    {
+        *out = *in;
+        out->ptd = NULL;
+    }
+    return DATA_S_SAMEFORMATETC;
+}
+
+static HRESULT WINAPI FileDataObjectImpl_SetData(IDataObject *iface, FORMATETC *fmt, STGMEDIUM *med, BOOL release)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI FileDataObjectImpl_EnumFormatEtc(IDataObject *iface, DWORD direction, IEnumFORMATETC **out)
+{
+    FileDataObjectImpl *This = impl_from_IFileDataObject(iface);
+
+    if (direction != DATADIR_GET)
+    {
+        *out = NULL;
+        return E_NOTIMPL;
+    }
+    return EnumFormatImpl_Create(&This->fmt, 1, out);
+}
+
+static HRESULT WINAPI FileDataObjectImpl_DAdvise(IDataObject *iface, FORMATETC *fmt, DWORD flags,
+                                                 IAdviseSink *sink, DWORD *connection)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI FileDataObjectImpl_DUnadvise(IDataObject *iface, DWORD connection)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI FileDataObjectImpl_EnumDAdvise(IDataObject *iface, IEnumSTATDATA **out)
+{
+    return E_NOTIMPL;
+}
+
+static const IDataObjectVtbl VT_FileDataObjectImpl =
+{
+    FileDataObjectImpl_QueryInterface,
+    FileDataObjectImpl_AddRef,
+    FileDataObjectImpl_Release,
+    FileDataObjectImpl_GetData,
+    FileDataObjectImpl_GetDataHere,
+    FileDataObjectImpl_QueryGetData,
+    FileDataObjectImpl_GetCanonicalFormatEtc,
+    FileDataObjectImpl_SetData,
+    FileDataObjectImpl_EnumFormatEtc,
+    FileDataObjectImpl_DAdvise,
+    FileDataObjectImpl_DUnadvise,
+    FileDataObjectImpl_EnumDAdvise
+};
+
+HRESULT ME_CreateFileDataObject(const WCHAR *path, IDataObject **dataobj)
+{
+    SIZE_T chars = lstrlenW(path) + 2; /* string plus the double terminator */
+    SIZE_T size = sizeof(DROPFILES) + chars * sizeof(WCHAR);
+    FileDataObjectImpl *obj;
+    DROPFILES *df;
+
+    TRACE("(%s)\n", debugstr_w(path));
+
+    if (!(obj = calloc(1, sizeof(*obj)))) return E_OUTOFMEMORY;
+    obj->IDataObject_iface.lpVtbl = &VT_FileDataObjectImpl;
+    obj->ref = 1;
+    if (!(obj->hdrop = GlobalAlloc(GHND, size)))
+    {
+        free(obj);
+        return E_OUTOFMEMORY;
+    }
+
+    df = GlobalLock(obj->hdrop);
+    df->pFiles = sizeof(DROPFILES);
+    df->fWide = TRUE;
+    memcpy((BYTE *)df + sizeof(DROPFILES), path, chars * sizeof(WCHAR));
+    GlobalUnlock(obj->hdrop);
+
+    InitFormatEtc(obj->fmt, CF_HDROP, TYMED_HGLOBAL);
+    *dataobj = &obj->IDataObject_iface;
+    return S_OK;
+}
