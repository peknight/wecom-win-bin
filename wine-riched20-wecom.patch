+/* Write the clipboard bitmap as a BMP file the host's file drop handling can
+ * pick up.  The X11 driver only ever hands us a DIB, so there is no PNG to
+ * reuse and no encoder in riched20. */
+static HRESULT save_clipboard_dib_as_bmp( WCHAR *path, DWORD len )
+{
+    BITMAPFILEHEADER header;
+    BITMAPINFO *bmi;
+    HGLOBAL hmem;
+    DWORD palette_size, image_size, dib_size, written;
+    WCHAR dir[MAX_PATH];
+    HANDLE file;
+    static ULONG counter;
+
+    if (!OpenClipboard( NULL )) return E_FAIL;
+    if (!(hmem = GetClipboardData( CF_DIB )) || !(bmi = GlobalLock( hmem )))
+    {
+        CloseClipboard();
+        return E_FAIL;
+    }
+
+    image_size = bmi->bmiHeader.biSizeImage;
+    if (!image_size && bmi->bmiHeader.biWidth > 0 && bmi->bmiHeader.biHeight)
+        image_size = ((bmi->bmiHeader.biWidth * bmi->bmiHeader.biBitCount + 31) / 32) * 4
+                     * abs( bmi->bmiHeader.biHeight );
+
+    palette_size = 0;
+    if (bmi->bmiHeader.biCompression == BI_BITFIELDS) palette_size = 12;
+    else if (bmi->bmiHeader.biBitCount <= 8) palette_size = (1 << bmi->bmiHeader.biBitCount) * sizeof(RGBQUAD);
+    dib_size = bmi->bmiHeader.biSize + palette_size + image_size;
+
+    if (dib_size <= bmi->bmiHeader.biSize + palette_size || dib_size > GlobalSize( hmem ))
+    {
+        TRACE("bad DIB size %lu (global %lu)\n", dib_size, (unsigned long)GlobalSize( hmem ));
+        GlobalUnlock( hmem );
+        CloseClipboard();
+        return E_FAIL;
+    }
+
+    GetTempPathW( MAX_PATH, dir );
+    delete_stale_paste_files( dir );
+    swprintf( path, len, L"%swecom-paste-%lu-%lu.bmp", dir,
+              (unsigned long)GetCurrentProcessId(),
+              (unsigned long)InterlockedIncrement( (LONG *)&counter ) );
+
+    header.bfType = 0x4d42; /* "BM" */
+    header.bfSize = sizeof(header) + dib_size;
+    header.bfReserved1 = 0;
+    header.bfReserved2 = 0;
+    header.bfOffBits = sizeof(header) + bmi->bmiHeader.biSize + palette_size;
+
+    file = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file != INVALID_HANDLE_VALUE)
+    {
+        WriteFile( file, &header, sizeof(header), &written, NULL );
+        WriteFile( file, bmi, dib_size, &written, NULL );
+        CloseHandle( file );
+    }
+    GlobalUnlock( hmem );
+    CloseClipboard();
+
+    TRACE("wrote %s (%lu bytes)\n", debugstr_w( path ), dib_size);
+    return file != INVALID_HANDLE_VALUE ? S_OK : E_FAIL;
+}
